@startuml
class Accesorio {
    + Accesorio()
    + Accesorio(id:int, nombre:string, categoria:CategoriaAccesorio, compatibilidad:string, cantidadDisponible:int, precio:decimal)
    + Id : int <<get>> <<set>>
    + Nombre : string <<get>> <<set>>
    + CategoriaAccesorio : CategoriaAccesorio <<get>> <<set>>
    + Compatibilidad : string <<get>> <<set>>
    + CantidadDisponible : int <<get>> <<set>>
    + Precio : decimal <<get>> <<set>>
}
enum CategoriaAccesorio {
    Boquillas,
    BasesImpresion,
    Herramientas,
    KitsLimpieza,
    Repuestos,
}

Accesorio o-- "0..* LineaCompraAccesorios" "LineaCompraAccesorio"
@enduml