@startuml

class LineaReserva {
    + LineaReserva()
    + Id : int <<get>> <<set>>
    + TiempoReserva : TiempoReserva <<get>> <<set>>
    + PrecioSubtotal : decimal <<get>> <<set>>
    + Impresora3D : Impresora3D <<get>> <<set>>
}

LineaReserva --> "TiempoReserva" TiempoReserva
LineaReserva --> "Impresora3D" Impresora3D

@enduml